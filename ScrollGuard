package com.example.brainpalclone
 
import android.content.Context
import android.os.Handler
import android.os.Looper
import com.google.firebase.FirebaseApp
import com.google.firebase.auth.FirebaseAuth
import com.google.firebase.firestore.FieldPath
import com.google.firebase.firestore.FirebaseFirestore
import com.google.firebase.firestore.ListenerRegistration
import kotlinx.coroutines.flow.MutableStateFlow
 
data class Rank(val uid: String, val name: String, val count: Int, val isMe: Boolean)
 
/** Scroll Battles: anonymous sign-in, friend codes, daily leaderboard (lowest count wins). */
object BattleRepo {
    val available = MutableStateFlow(false)
    val myCode = MutableStateFlow("")
    val myName = MutableStateFlow("")
    val board = MutableStateFlow<List<Rank>>(emptyList())
    val message = MutableStateFlow("")
 
    private var started = false
    private var uid: String? = null
    private var friends: List<String> = emptyList()
    private var friendsReg: ListenerRegistration? = null
    private var boardReg: ListenerRegistration? = null
    private val handler = Handler(Looper.getMainLooper())
    private val pushRunnable = Runnable { pushNow() }
 
    private val db get() = FirebaseFirestore.getInstance()
 
    fun init(ctx: Context) {
        if (started) return
        if (FirebaseApp.getApps(ctx.applicationContext).isEmpty()) return // no google-services.json
        started = true
        available.value = true
        val auth = FirebaseAuth.getInstance()
        val current = auth.currentUser
        if (current != null) onSignedIn(current.uid)
        else auth.signInAnonymously()
            .addOnSuccessListener { r -> r.user?.uid?.let { onSignedIn(it) } }
            .addOnFailureListener { message.value = "Sign-in failed: ${it.message}" }
    }
 
    private fun onSignedIn(u: String) {
        uid = u
        val ref = db.collection("users").document(u)
        ref.get().addOnSuccessListener { doc ->
            if (!doc.exists()) {
                val chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
                val code = (1..6).map { chars.random() }.joinToString("")
                val name = "Player" + code.take(3)
                ref.set(mapOf("name" to name, "code" to code))
                myCode.value = code; myName.value = name
            } else {
                myCode.value = doc.getString("code") ?: ""
                myName.value = doc.getString("name") ?: ""
            }
            listenFriends(u)
            syncToday()
        }.addOnFailureListener { message.value = "Could not load profile: ${it.message}" }
    }
 
    private fun listenFriends(u: String) {
        friendsReg?.remove()
        friendsReg = db.collection("users").document(u).collection("friends")
            .addSnapshotListener { snap, _ ->
                friends = snap?.documents?.map { it.id } ?: emptyList()
                listenBoard()
            }
    }
 
    /** Re-subscribes to today's board (also call when the app opens, to roll over at midnight). */
    fun listenBoard() {
        val me = uid ?: return
        boardReg?.remove()
        val d = CounterStore.todayKey()
        val ids = (friends + me).distinct().take(30).map { "${d}_$it" }
        boardReg = db.collection("daily").whereIn(FieldPath.documentId(), ids)
            .addSnapshotListener { snap, _ ->
                board.value = snap?.documents?.mapNotNull { doc ->
                    val id = doc.getString("uid") ?: return@mapNotNull null
                    Rank(id, doc.getString("name") ?: "Player", (doc.getLong("count") ?: 0L).toInt(), id == me)
                }?.sortedBy { it.count } ?: emptyList()
            }
    }
 
    fun syncToday() {
        if (uid == null) return
        handler.removeCallbacks(pushRunnable)
        handler.postDelayed(pushRunnable, 3000) // trailing debounce
    }
 
    private fun pushNow() {
        val u = uid ?: return
        val d = CounterStore.todayKey()
        db.collection("daily").document("${d}_$u").set(
            mapOf("uid" to u, "name" to myName.value, "date" to d, "count" to CounterStore.total())
        )
    }
 
    fun setName(name: String) {
        val u = uid ?: return
        val n = name.trim().take(16)
        if (n.isEmpty()) return
        myName.value = n
        db.collection("users").document(u).update("name", n)
        pushNow()
    }
 
    fun addFriend(code: String) {
        val me = uid ?: return
        val c = code.trim().uppercase()
        if (c.length != 6) { message.value = "Codes are 6 characters"; return }
        db.collection("users").whereEqualTo("code", c).limit(1).get()
            .addOnSuccessListener { res ->
                val f = res.documents.firstOrNull()
                when {
                    f == null -> message.value = "No user found with that code"
                    f.id == me -> message.value = "That's your own code"
                    else -> {
                        db.collection("users").document(me).collection("friends").document(f.id).set(emptyMap<String, Any>())
                        message.value = "Added ${f.getString("name") ?: "friend"}"
                    }
                }
            }
            .addOnFailureListener { message.value = "Error: ${it.message}" }
    }
}
 
