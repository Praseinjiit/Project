package com.example.brainpalclone
 
import android.content.Context
import android.content.SharedPreferences
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale
 
data class ReelApp(val pkg: String, val name: String, val viewIdHints: List<String>)
 
val REEL_APPS = listOf(
    ReelApp("com.instagram.android", "Instagram Reels", listOf("clips_viewer", "reels_viewer", "clips_video")),
    ReelApp("com.google.android.youtube", "YouTube Shorts", listOf("reel_recycler", "reel_player_page_container", "shorts")),
    ReelApp("com.facebook.katana", "Facebook Reels", listOf("reels", "reel_viewer")),
    ReelApp("com.snapchat.android", "Snapchat Spotlight", listOf("spotlight", "reel")),
)
 
object CounterStore {
    private lateinit var prefs: SharedPreferences
    private val _counts = MutableStateFlow<Map<String, Int>>(emptyMap())
    val counts: StateFlow<Map<String, Int>> = _counts
    private val _limit = MutableStateFlow(100)
    val limit: StateFlow<Int> = _limit
    private val _blockEnabled = MutableStateFlow(false)
    val blockEnabled: StateFlow<Boolean> = _blockEnabled
 
    fun todayKey(): String = SimpleDateFormat("yyyy-MM-dd", Locale.US).format(Date())
 
    fun init(ctx: Context) {
        if (::prefs.isInitialized) return
        prefs = ctx.applicationContext.getSharedPreferences("scrollguard", Context.MODE_PRIVATE)
        _limit.value = prefs.getInt("limit", 100)
        _blockEnabled.value = prefs.getBoolean("block", false)
        refresh()
    }
 
    private fun refresh() {
        val d = todayKey()
        _counts.value = REEL_APPS.associate { it.pkg to prefs.getInt("$d:${it.pkg}", 0) }
    }
 
    fun increment(pkg: String) {
        val d = todayKey()
        prefs.edit().putInt("$d:$pkg", prefs.getInt("$d:$pkg", 0) + 1).apply()
        refresh()
        BattleRepo.syncToday()
    }
 
    fun total() = _counts.value.values.sum()
 
    fun setLimit(v: Int) { _limit.value = v; prefs.edit().putInt("limit", v).apply() }
    fun setBlock(v: Boolean) { _blockEnabled.value = v; prefs.edit().putBoolean("block", v).apply() }
    fun resetToday() {
        val d = todayKey()
        val e = prefs.edit()
        REEL_APPS.forEach { e.remove("$d:${it.pkg}") }
        e.apply(); refresh(); BattleRepo.syncToday()
    }
}
 
