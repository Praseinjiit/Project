private data class BrainState(val emoji: String, val label: String, val color: Color)
 
private fun brainFor(count: Int) = when {
    count < 50 -> BrainState("🧠", "Healthy", Color(0xFF4CAF50))
    count < 100 -> BrainState("😵‍💫", "Getting foggy", Color(0xFF8BC34A))
    count < 200 -> BrainState("💥", "Cracking", Color(0xFFFF7043))
    else -> BrainState("💀", "Gone", Color(0xFFE53935))
}
 
