package com.example.brainpalclone
 
import android.accessibilityservice.AccessibilityService
import android.view.accessibility.AccessibilityEvent
import android.view.accessibility.AccessibilityNodeInfo
import android.widget.Toast
 
class ReelAccessibilityService : AccessibilityService() {
 
    private var lastCountAt = 0L
 
    override fun onServiceConnected() {
        super.onServiceConnected()
        CounterStore.init(this)
        BattleRepo.init(this)
    }
 
    override fun onAccessibilityEvent(event: AccessibilityEvent?) {
        event ?: return
        CounterStore.init(this)
        val pkg = event.packageName?.toString() ?: return
        val app = REEL_APPS.firstOrNull { it.pkg == pkg } ?: return
 
        val root = rootInActiveWindow ?: return
        if (!isReelsScreen(root, app)) return
 
        // Block once the limit is reached
        if (CounterStore.blockEnabled.value && CounterStore.total() >= CounterStore.limit.value) {
            Toast.makeText(this, "Reel limit reached. Take a break.", Toast.LENGTH_SHORT).show()
            performGlobalAction(GLOBAL_ACTION_HOME)
            return
        }
 
        if (event.eventType == AccessibilityEvent.TYPE_VIEW_SCROLLED) {
            val now = System.currentTimeMillis()
            // Debounce: one swipe fires several scroll events
            if (now - lastCountAt > 800) {
                lastCountAt = now
                CounterStore.increment(pkg)
            }
        }
    }
 
    /** Heuristic: the reels/shorts pager is on screen if any node's view id contains a known hint. */
    private fun isReelsScreen(root: AccessibilityNodeInfo, app: ReelApp): Boolean {
        val stack = ArrayDeque<AccessibilityNodeInfo>()
        stack.add(root)
        var visited = 0
        while (stack.isNotEmpty() && visited < 400) {
            val n = stack.removeLast()
            visited++
            val id = n.viewIdResourceName?.lowercase()
            if (id != null && app.viewIdHints.any { id.contains(it) }) return true
            for (i in 0 until n.childCount) n.getChild(i)?.let { stack.add(it) }
        }
        return false
    }
 
    override fun onInterrupt() {}
}
 
